{
    "name": "alt-design/alt-live-editor",
    "description": "Edit Statamic entry content by clicking it in the Live Preview iframe. Changes go into the publish form and are saved as normal.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "live-preview",
        "page-builder",
        "inline-editing",
        "control-panel"
    ],
    "authors": [
        {
            "name": "Alt Design",
            "homepage": "https://alt-design.net"
        }
    ],
    "support": {
        "issues": "https://github.com/alt-design/Alt-Live-Editor-Addon/issues"
    },
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.40"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "AltDesign\\AltLiveEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AltDesign\\AltLiveEditor\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Alt Live Editor",
            "description": "Edit entry content by clicking it in the Live Preview iframe."
        },
        "laravel": {
            "providers": [
                "AltDesign\\AltLiveEditor\\ServiceProvider"
            ]
        }
    }
}
