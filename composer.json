{
    "name": "alt-design/alt-live-editor",
    "description": "Edit fields directly inside the Statamic Live Preview iframe.",
    "version": "1.0.0",
    "type": "statamic-addon",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "AltDesign\\AltLiveEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AltDesign\\AltLiveEditor\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Alt Live Editor",
            "description": "Edit fields directly inside the Statamic Live Preview iframe."
        },
        "laravel": {
            "providers": [
                "AltDesign\\AltLiveEditor\\ServiceProvider"
            ]
        }
    }
}
